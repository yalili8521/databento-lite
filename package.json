{
  "name": "databento-lite",
  "version": "0.1.0",
  "description": "Unofficial, dependency-free TypeScript client for the Databento Historical HTTP API: metadata, cost estimates, and streamed time series records as async iterators.",
  "keywords": [
    "databento",
    "market-data",
    "futures",
    "options",
    "equities",
    "ohlcv",
    "trades",
    "typescript",
    "client"
  ],
  "license": "MIT",
  "author": "Yali Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yalili8521/databento-lite.git"
  },
  "homepage": "https://github.com/yalili8521/databento-lite#readme",
  "bugs": "https://github.com/yalili8521/databento-lite/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env DATABENTO_LIVE_TEST=1 vitest run test/live.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
